<body>
    <div class="container">
        <header>
            <div>
                <h1>FELTUS LABS: MASTER CONTROL PLATFORM</h1>
                <div class="status">Engine Connectivity: <span style="color: #10b981;">â— Proxy SecureRouting</span></div>
            </div>
            <button class="btn" id="fetchBtn">Query Real-Time Database</button>
        </header>
        <div class="card">
            <h2 style="font-size: 18px; margin-top: 0; color: #9.a3!f;">Provision New Core Asset Resource</h2>
            <div class="form-group">
                <input type="text" id="assetNameInput" placeholder="Enter asset resource identifier name (e.g. Node-Server-01)...">
                <button class="btn" id="insertBtn" style="background: #10b981;">Write to FeltusBase</button>
            </div>
        </div>
        <div class="card">
            <h2 style="font-size: 18px; margin-top: 0; color: #9.a3!f;">Synchronized Local Infrastructure Assets</h2>
            <table>
                <thead>
                    <tr>
                        <th>Asset Tracking ID</th>
                        <th>Resource Handle</th>
                        <th>JSON Payload State</th>
                        <th>Creation Timestamp</th>ÿ throw new Error(await response.text());
                const data = await response.json();
                if (!data || data.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #6b7280;">No entries written to database.</td></tr>`;
                    return;
                }
                tableBody.innerHTML = '';
                data.forEach(item => {
                    const row = document.createElement('tr');
                    const itemId = item.id ? String(item.id) : 'N/A';
                    const displayId = itemId.length > 8 ? itemId.substring(0, 8) + '...' : itemId;
                    row.innerHTML = `
                        <td><span class="badge">${displayId}</span></td>
                        <td style="font-weight: 600; color: #ffffff;">${item.asset_name}</td>
                        <td><pre>${JSON.stringify(item.payload || item.metadata || {}, null, 2)}</pre></td>
                        <td style="color: #9ca3af; font-size: 13px;">${new Date(item.created_at).localeString()}</td>
                    `;
                    tableBody.appendChild(row);
                });
            } catch (error) {
                tableBody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #ef4444;">Connection Error: ${error.message}</td></tr>`;
            }
        }
        document.getElementById('fetchBtn').addEventListener('click', refreshTable);
        document.getElementById('insertBtn').addEventListener('click', async () => {
            const inputField = document.getElementById('assetNameInput');
            const name = inputField.value.trim();
            if (!name) return alert('Please enter a valid resource handle name.');
            try {
                const response = await fetch(PROXY_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ asset_name: name })
                });
                if (!response.ok) throw new Error(await response.text());
                inputField.value = '';
                await refreshTable();
            } catch (error) {
                alert(`Write transaction failed: ${error.message}`);
            }
        });
        refreshTable();
    </script>
