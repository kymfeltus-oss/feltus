import http from "node:http";
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const projectRoot = path.resolve(__dirname, "..");

const HOST = "127.0.0.1";
const PORT = 8080;
const GATEWAY = "http://127.0.0.1:54321";

const API_KEY = process.env.FELTUS_PUBLISHABLE_KEY;
const LOCAL_DEV_MODE =
  process.env.FELTUS_LOCAL_DEV_MODE === "1";

const DEV_AUTH_FILE = path.join(
  projectRoot,
  ".feltus-dev-auth.json"
);

const ALLOWED_ORIGINS = new Set([
  "http://127.0.0.1:8080",
  "http://localhost:8080",
  "https://kyemba.tailb2f227.ts.net"
]);

const UUID_PATTERN =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

let devCredentials = null;
let devSession = null;

if (!LOCAL_DEV_MODE) {
  throw new Error(
    "FELTUS_LOCAL_DEV_MODE=1 is required."
  );
}

if (
  !API_KEY ||
  !API_KEY.startsWith("sb_publishable_")
) {
  throw new Error(
    "FELTUS_PUBLISHABLE_KEY is required."
  );
}

function send(res, status, data) {
  res.writeHead(status, {
    "Content-Type":
      "application/json; charset=utf-8",
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff"
  });

  res.end(JSON.stringify(data));
}

function isLocalRequest(req) {
  const address =
    req.socket.remoteAddress;

  return (
    address === "127.0.0.1" ||
    address === "::1" ||
    address === "::ffff:127.0.0.1"
  );
}

function trustedOrigin(req) {
  const origin =
    req.headers.origin;

  if (!origin) {
    return true;
  }

  return ALLOWED_ORIGINS.has(origin);
}

async function readBody(req) {
  let body = "";
  let bytes = 0;

  for await (const chunk of req) {
    bytes += chunk.length;

    if (bytes > 32768) {
      const error =
        new Error("Request too large.");

      error.status = 413;

      throw error;
    }

    body += chunk.toString();
  }

  try {
    return JSON.parse(
      body || "{}"
    );
  } catch {
    const error =
      new Error("Invalid JSON.");

    error.status = 400;

    throw error;
  }
}

async function upstream(
  endpoint,
  options = {}
) {
  const response =
    await fetch(
      GATEWAY + endpoint,
      {
        ...options,

        headers: {
          apikey: API_KEY,
          Accept: "application/json",
          ...(options.headers || {})
        }
      }
    );

  const text =
    await response.text();

  let data;

  try {
    data = JSON.parse(text);
  } catch {
    data = {
      error:
        "Unexpected upstream response."
    };
  }

  return {
    status: response.status,
    data
  };
}

function createCredentialsFile() {
  const credentials = {
    email:
      `feltus-local-${crypto.randomUUID()}@example.test`,

    password:
      crypto
        .randomBytes(32)
        .toString("hex") +
      "Aa1!"
  };

  fs.writeFileSync(
    DEV_AUTH_FILE,
    JSON.stringify(
      credentials,
      null,
      2
    ),
    {
      flag: "wx",
      mode: 0o600
    }
  );

  return credentials;
}

function loadCredentials() {
  if (
    !fs.existsSync(
      DEV_AUTH_FILE
    )
  ) {
    return createCredentialsFile();
  }

  const credentials =
    JSON.parse(
      fs.readFileSync(
        DEV_AUTH_FILE,
        "utf8"
      )
    );

  if (
    !credentials.email ||
    !credentials.password
  ) {
    throw new Error(
      "Invalid FELTUS development credentials."
    );
  }

  return credentials;
}

async function signup(
  credentials
) {
  return upstream(
    "/auth/v1/signup",
    {
      method: "POST",

      headers: {
        "Content-Type":
          "application/json"
      },

      body:
        JSON.stringify(
          credentials
        )
    }
  );
}

async function login(
  credentials
) {
  const result =
    await upstream(
      "/auth/v1/token?grant_type=password",
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json"
        },

        body:
          JSON.stringify(
            credentials
          )
      }
    );

  if (
    result.status !== 200 ||
    !result.data?.access_token ||
    !result.data?.user?.id
  ) {
    throw new Error(
      `Local FELTUS authentication failed: HTTP ${result.status}`
    );
  }

  return result.data;
}

async function initializeDevIdentity() {
  const alreadyExists =
    fs.existsSync(
      DEV_AUTH_FILE
    );

  devCredentials =
    loadCredentials();

  if (!alreadyExists) {
    const result =
      await signup(
        devCredentials
      );

    if (
      result.status < 200 ||
      result.status >= 300
    ) {
      throw new Error(
        `Development account creation failed: HTTP ${result.status}`
      );
    }
  }

  devSession =
    await login(
      devCredentials
    );

  console.log(
    "FELTUS local development identity initialized."
  );
}

async function renewSession() {
  devSession =
    await login(
      devCredentials
    );
}

async function tableRequest(
  table,
  method,
  {
    body = null,
    query = ""
  } = {}
) {
  if (
    !devSession?.access_token
  ) {
    await renewSession();
  }

  const execute =
    async () => {
      const headers = {
        Authorization:
          `Bearer ${devSession.access_token}`
      };

      if (
        method === "POST" ||
        method === "PATCH"
      ) {
        headers["Content-Type"] =
          "application/json";

        headers.Prefer =
          "return=representation";
      }

      return upstream(
        `/rest/v1/${table}${query}`,
        {
          method,
          headers,

          ...(body
            ? {
                body:
                  JSON.stringify(body)
              }
            : {})
        }
      );
    };

  let result =
    await execute();

  if (
    result.status === 401
  ) {
    await renewSession();

    result =
      await execute();
  }

  return result;
}

async function appRequest(
  method,
  body = null
) {
  return tableRequest(
    "feltus_applications",
    method,
    {
      body,

      query:
        method === "GET"
          ? "?select=*&order=created_at.desc"
          : ""
    }
  );
}

async function assetRequest(
  method,
  {
    body = null,
    appId = null
  } = {}
) {
  let query = "";

  if (method === "GET") {
    query =
      "?select=*&order=created_at.desc";

    if (appId) {
      query +=
        `&app_id=eq.${encodeURIComponent(appId)}`;
    }
  }

  return tableRequest(
    "user_assets",
    method,
    {
      body,
      query
    }
  );
}

const server =
  http.createServer(
    async (req, res) => {
      try {
        if (
          !isLocalRequest(req)
        ) {
          return send(
            res,
            403,
            {
              error:
                "Local development access only."
            }
          );
        }

        if (
          !trustedOrigin(req)
        ) {
          return send(
            res,
            403,
            {
              error:
                "Untrusted request origin."
            }
          );
        }

        const url =
          new URL(
            req.url,
            `http://${HOST}:${PORT}`
          );

        if (
          (
            url.pathname === "/" ||
            url.pathname ===
              "/index.html"
          ) &&
          req.method === "GET"
        ) {
          const file =
            path.join(
              projectRoot,
              "index.html"
            );

          return fs.readFile(
            file,
            (
              error,
              content
            ) => {
              if (error) {
                return send(
                  res,
                  500,
                  {
                    error:
                      "Dashboard unavailable."
                  }
                );
              }

              res.writeHead(
                200,
                {
                  "Content-Type":
                    "text/html; charset=utf-8",

                  "Cache-Control":
                    "no-store",

                  "X-Content-Type-Options":
                    "nosniff"
                }
              );

              res.end(content);
            }
          );
        }

        if (
          url.pathname ===
            "/api/health" &&
          req.method === "GET"
        ) {
          return send(
            res,
            200,
            {
              status:
                "online",

              mode:
                "local-development",

              authenticated:
                Boolean(
                  devSession
                    ?.access_token
                )
            }
          );
        }

        if (
          url.pathname ===
          "/api/apps"
        ) {
          if (
            req.method === "GET"
          ) {
            const result =
              await appRequest(
                "GET"
              );

            return send(
              res,
              result.status,
              result.data
            );
          }

          if (
            req.method === "POST"
          ) {
            const body =
              await readBody(req);

            const name =
              body.app_name;

            const environment =
              typeof body.environment ===
                "string" &&
              body.environment.trim()
                ? body.environment.trim()
                : "development";

            if (
              typeof name !==
                "string" ||
              !name.trim() ||
              name.length > 200
            ) {
              return send(
                res,
                400,
                {
                  error:
                    "Invalid application name."
                }
              );
            }

            const allowed =
              [
                "development",
                "staging",
                "production"
              ];

            if (
              !allowed.includes(
                environment
              )
            ) {
              return send(
                res,
                400,
                {
                  error:
                    "Invalid environment."
                }
              );
            }

            const record = {
              owner_id:
                devSession.user.id,

              app_name:
                name.trim(),

              environment
            };

            const result =
              await appRequest(
                "POST",
                record
              );

            return send(
              res,
              result.status,
              result.data
            );
          }

          return send(
            res,
            405,
            {
              error:
                "Method not allowed."
            }
          );
        }

        if (
          url.pathname ===
          "/api/assets"
        ) {
          if (
            req.method === "GET"
          ) {
            const appId =
              url.searchParams.get(
                "app_id"
              );

            if (
              appId &&
              !UUID_PATTERN.test(
                appId
              )
            ) {
              return send(
                res,
                400,
                {
                  error:
                    "Invalid application ID."
                }
              );
            }

            const result =
              await assetRequest(
                "GET",
                {
                  appId
                }
              );

            return send(
              res,
              result.status,
              result.data
            );
          }

          if (
            req.method === "POST"
          ) {
            const body =
              await readBody(req);

            const name =
              body.asset_name;

            const appId =
              body.app_id || null;

            if (
              typeof name !==
                "string" ||
              !name.trim() ||
              name.length > 200
            ) {
              return send(
                res,
                400,
                {
                  error:
                    "Invalid asset name."
                }
              );
            }

            if (
              appId &&
              !UUID_PATTERN.test(
                appId
              )
            ) {
              return send(
                res,
                400,
                {
                  error:
                    "Invalid application ID."
                }
              );
            }

            const record = {
              user_id:
                devSession.user.id,

              asset_name:
                name.trim(),

              payload: {
                client_origin:
                  "FELTUS LABS Local Console",

                environment:
                  "development"
              }
            };

            if (appId) {
              record.app_id =
                appId;
            }

            const result =
              await assetRequest(
                "POST",
                {
                  body: record
                }
              );

            return send(
              res,
              result.status,
              result.data
            );
          }

          return send(
            res,
            405,
            {
              error:
                "Method not allowed."
            }
          );
        }

        return send(
          res,
          404,
          {
            error:
              "Route not found."
          }
        );
      } catch (error) {
        console.error(
          "FELTUS local proxy failure:",
          error.message
        );

        return send(
          res,
          error.status || 502,
          {
            error:
              error.status
                ? error.message
                : "Local FELTUS service unavailable."
          }
        );
      }
    }
  );

server.on(
  "error",
  error => {
    if (
      error.code ===
      "EADDRINUSE"
    ) {
      console.error(
        `Port ${PORT} is already occupied by another process.`
      );

      process.exitCode = 1;

      return;
    }

    throw error;
  }
);

async function start() {
  await initializeDevIdentity();

  server.listen(
    PORT,
    HOST,
    () => {
      console.log("");
      console.log(
        "=== FELTUS LABS ==="
      );

      console.log(
        `Console: http://${HOST}:${PORT}`
      );

      console.log(
        "Mode: LOCAL DEVELOPMENT"
      );

      console.log(
        "Manual Login: DISABLED"
      );

      console.log(
        "Project Registry: ENABLED"
      );

      console.log(
        "Project-Scoped Assets: ENABLED"
      );

      console.log("");
    }
  );
}

start().catch(
  error => {
    console.error(
      "FELTUS startup failure:",
      error.message
    );

    process.exitCode = 1;
  }
);
