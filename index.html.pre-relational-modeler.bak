<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FELTUS LABS | Master Command Console</title>

<style>
:root {
  color-scheme: dark;
  font-family: "Segoe UI", system-ui, sans-serif;
  background: #0d1016;
  color: #edf1f6;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(150,170,200,.08), transparent 35%),
    #0d1016;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 22px 5%;
  border-bottom: 1px solid #2b3340;
  background: rgba(13,16,22,.96);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand h1 {
  margin: 0;
  font-size: 23px;
  letter-spacing: .09em;
}

.brand small {
  display: block;
  margin-top: 5px;
  color: #818c9c;
  letter-spacing: .08em;
}

.mode {
  padding: 8px 12px;
  border: 1px solid #354152;
  border-radius: 999px;
  font-size: 12px;
  color: #a9d7bc;
  background: #171c24;
}

main {
  width: min(1240px, calc(100% - 36px));
  margin: 34px auto 60px;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-end;
  margin-bottom: 28px;
}

.hero h2 {
  margin: 0 0 8px;
  font-size: 30px;
}

.hero p {
  margin: 0;
  color: #929cac;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.metric,
.panel,
.project-card {
  background: #181d26;
  border: 1px solid #2d3542;
  border-radius: 14px;
}

.metric {
  padding: 18px;
}

.metric-label {
  color: #808b9a;
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: .08em;
}

.metric-value {
  margin-top: 8px;
  font-size: 22px;
  font-weight: 650;
}

.panel {
  padding: 24px;
  margin-bottom: 22px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  margin-bottom: 18px;
}

.panel h3 {
  margin: 0;
  font-size: 18px;
}

.panel p {
  color: #8f99a8;
}

input,
select {
  padding: 12px 13px;
  border-radius: 8px;
  border: 1px solid #445063;
  background: #0f141c;
  color: #fff;
  font: inherit;
}

input {
  flex: 1;
  min-width: 0;
}

select {
  min-width: 160px;
}

button {
  padding: 12px 17px;
  border: 0;
  border-radius: 8px;
  background: #dbe3ec;
  color: #151a22;
  font-weight: 650;
  cursor: pointer;
}

button.secondary {
  background: #303845;
  color: #edf1f6;
}

button:disabled {
  opacity: .5;
  cursor: wait;
}

.inline {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
}

.project-card {
  padding: 18px;
  cursor: pointer;
  transition: .15s ease;
}

.project-card:hover {
  transform: translateY(-2px);
  border-color: #58677b;
}

.project-card.active {
  border-color: #a8b8cc;
  box-shadow: 0 0 0 1px #a8b8cc inset;
}

.project-name {
  font-size: 17px;
  font-weight: 650;
  margin-bottom: 8px;
}

.project-meta {
  font-size: 12px;
  color: #8d98a7;
  line-height: 1.6;
}

.badge {
  display: inline-block;
  margin-top: 10px;
  padding: 5px 8px;
  border-radius: 999px;
  background: #252d38;
  font-size: 11px;
  color: #b9c5d3;
}

.status {
  min-height: 24px;
  margin-top: 12px;
  font-size: 13px;
  color: #96a1b0;
}

.success {
  color: #9fd9bd;
}

.error {
  color: #ff9696;
}

.context-box {
  padding: 16px;
  background: #11161e;
  border: 1px solid #2c3440;
  border-radius: 10px;
  margin-bottom: 16px;
}

.context-name {
  font-weight: 650;
}

.context-id {
  margin-top: 5px;
  font: 12px Consolas, monospace;
  color: #8592a3;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  text-align: left;
  padding: 13px;
  border-bottom: 1px solid #2c3440;
  vertical-align: top;
}

th {
  color: #8b96a6;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

pre {
  margin: 0;
  white-space: pre-wrap;
  font-size: 12px;
  font-family: Consolas, monospace;
  color: #b9c3d0;
}

.empty {
  padding: 28px;
  text-align: center;
  color: #737f90;
}

.hidden {
  display: none !important;
}

footer {
  text-align: center;
  color: #667284;
  font-size: 12px;
  padding: 8px 0;
}

@media (max-width: 850px) {
  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero,
  .panel-header {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (max-width: 560px) {
  .metrics {
    grid-template-columns: 1fr;
  }

  .inline {
    flex-direction: column;
  }

  input,
  select,
  button {
    width: 100%;
  }
}
</style>
</head>

<body>

<header>
  <div class="brand">
    <h1>FELTUS LABS</h1>
    <small>MASTER COMMAND CONSOLE</small>
  </div>

  <div class="mode">
    PRIVATE LOCAL DEVELOPMENT
  </div>
</header>

<main>

  <section class="hero">
    <div>
      <h2>Platform Command Center</h2>
      <p>
        Projects, infrastructure assets and local platform state.
      </p>
    </div>

    <button
      id="refreshAllBtn"
      class="secondary"
      type="button"
    >
      Refresh Platform
    </button>
  </section>

  <section class="metrics">
    <div class="metric">
      <div class="metric-label">FELTUS Engine</div>
      <div id="engineMetric" class="metric-value">Checking</div>
    </div>

    <div class="metric">
      <div class="metric-label">Projects</div>
      <div id="projectMetric" class="metric-value">—</div>
    </div>

    <div class="metric">
      <div class="metric-label">Selected Assets</div>
      <div id="assetMetric" class="metric-value">—</div>
    </div>

    <div class="metric">
      <div class="metric-label">Access</div>
      <div class="metric-value">Private</div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h3>Deploy New Project</h3>
        <p>Create a real FELTUS application workspace.</p>
      </div>
    </div>

    <form id="projectForm" class="inline">
      <input
        id="projectNameInput"
        type="text"
        maxlength="200"
        required
        placeholder="Project name"
      >

      <select id="environmentInput">
        <option value="development">Development</option>
        <option value="staging">Staging</option>
        <option value="production">Production</option>
      </select>

      <button id="createProjectBtn" type="submit">
        Create Project
      </button>
    </form>

    <div id="projectStatus" class="status"></div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h3>Application Registry</h3>
        <p>Select a project to manage its infrastructure.</p>
      </div>
    </div>

    <div id="projectGrid" class="project-grid"></div>
  </section>

  <section id="workspacePanel" class="panel hidden">
    <div class="panel-header">
      <div>
        <h3>Project Workspace</h3>
        <p>Provision and inspect project-scoped infrastructure.</p>
      </div>
    </div>

    <div class="context-box">
      <div id="selectedProjectName" class="context-name"></div>
      <div id="selectedProjectId" class="context-id"></div>
      <div id="selectedProjectEnvironment" class="badge"></div>
    </div>

    <form id="assetForm" class="inline">
      <input
        id="assetNameInput"
        type="text"
        maxlength="200"
        required
        placeholder="New project asset"
      >

      <button id="createAssetBtn" type="submit">
        Create Asset
      </button>
    </form>

    <div id="assetStatus" class="status"></div>
  </section>

  <section id="assetPanel" class="panel hidden">
    <div class="panel-header">
      <div>
        <h3>Project Infrastructure</h3>
        <p>Live database-backed assets for the selected project.</p>
      </div>

      <button
        id="refreshAssetsBtn"
        class="secondary"
        type="button"
      >
        Refresh Assets
      </button>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Tracking ID</th>
            <th>Resource</th>
            <th>Payload</th>
            <th>Created</th>
          </tr>
        </thead>

        <tbody id="assetRows"></tbody>
      </table>
    </div>
  </section>

  <footer>
    FELTUS LABS · Private Development Platform
  </footer>

</main>

<script>
"use strict";

const $ = id => document.getElementById(id);

let projects = [];
let selectedProject = null;

function setStatus(element, message, error = false) {
  element.textContent = message;

  element.className =
    "status " +
    (error ? "error" : "success");
}

async function requestJson(url, options = {}) {
  const response = await fetch(url, {
    ...options,

    headers: {
      Accept: "application/json",
      ...(options.body
        ? { "Content-Type": "application/json" }
        : {}),
      ...(options.headers || {})
    }
  });

  const text = await response.text();

  let data;

  try {
    data = JSON.parse(text);
  } catch {
    data = {};
  }

  if (!response.ok) {
    throw new Error(
      data.error ||
      data.message ||
      `HTTP ${response.status}`
    );
  }

  return data;
}

async function loadHealth() {
  try {
    const health =
      await requestJson("/api/health");

    $("engineMetric").textContent =
      health.status === "online"
        ? "Online"
        : "Offline";
  } catch {
    $("engineMetric").textContent =
      "Offline";
  }
}

function projectCard(project) {
  const card =
    document.createElement("div");

  card.className =
    "project-card" +
    (
      selectedProject?.id === project.id
        ? " active"
        : ""
    );

  const name =
    document.createElement("div");

  name.className =
    "project-name";

  name.textContent =
    project.app_name;

  const meta =
    document.createElement("div");

  meta.className =
    "project-meta";

  meta.textContent =
    `Created ${new Date(
      project.created_at
    ).toLocaleString()}`;

  const badge =
    document.createElement("div");

  badge.className =
    "badge";

  badge.textContent =
    project.environment;

  card.append(
    name,
    meta,
    badge
  );

  card.addEventListener(
    "click",
    async () => {
      selectedProject =
        project;

      renderProjects();

      await openProject(
        project
      );
    }
  );

  return card;
}

function renderProjects() {
  const grid =
    $("projectGrid");

  grid.replaceChildren();

  $("projectMetric").textContent =
    String(projects.length);

  if (!projects.length) {
    const empty =
      document.createElement("div");

    empty.className =
      "empty";

    empty.textContent =
      "No FELTUS projects have been deployed.";

    grid.appendChild(empty);

    return;
  }

  for (const project of projects) {
    grid.appendChild(
      projectCard(project)
    );
  }
}

async function loadProjects() {
  setStatus(
    $("projectStatus"),
    "Synchronizing project registry..."
  );

  try {
    projects =
      await requestJson(
        "/api/apps"
      );

    if (
      !Array.isArray(projects)
    ) {
      throw new Error(
        "Invalid project response."
      );
    }

    renderProjects();

    setStatus(
      $("projectStatus"),
      `${projects.length} project(s) synchronized`
    );

    if (
      selectedProject
    ) {
      const refreshed =
        projects.find(
          project =>
            project.id ===
            selectedProject.id
        );

      if (refreshed) {
        selectedProject =
          refreshed;

        await openProject(
          refreshed
        );
      }
    }
  } catch (error) {
    setStatus(
      $("projectStatus"),
      error.message,
      true
    );
  }
}

async function openProject(project) {
  $("workspacePanel")
    .classList
    .remove("hidden");

  $("assetPanel")
    .classList
    .remove("hidden");

  $("selectedProjectName")
    .textContent =
    project.app_name;

  $("selectedProjectId")
    .textContent =
    project.id;

  $("selectedProjectEnvironment")
    .textContent =
    project.environment;

  await loadAssets();
}

async function loadAssets() {
  if (!selectedProject) {
    return;
  }

  setStatus(
    $("assetStatus"),
    "Loading project assets..."
  );

  try {
    const assets =
      await requestJson(
        `/api/assets?app_id=${encodeURIComponent(
          selectedProject.id
        )}`
      );

    if (
      !Array.isArray(assets)
    ) {
      throw new Error(
        "Invalid asset response."
      );
    }

    $("assetMetric").textContent =
      String(assets.length);

    const rows =
      $("assetRows");

    rows.replaceChildren();

    if (!assets.length) {
      const row =
        document.createElement("tr");

      const cell =
        document.createElement("td");

      cell.colSpan = 4;
      cell.className =
        "empty";

      cell.textContent =
        "No assets exist for this project.";

      row.appendChild(cell);
      rows.appendChild(row);
    }

    for (const asset of assets) {
      const row =
        document.createElement("tr");

      const values = [
        asset.id || "",
        asset.asset_name || "",
        asset.payload || {},
        asset.created_at
          ? new Date(
              asset.created_at
            ).toLocaleString()
          : ""
      ];

      values.forEach(
        (value, index) => {
          const cell =
            document.createElement("td");

          if (index === 2) {
            const pre =
              document.createElement("pre");

            pre.textContent =
              JSON.stringify(
                value,
                null,
                2
              );

            cell.appendChild(pre);
          } else {
            cell.textContent =
              String(value);
          }

          row.appendChild(cell);
        }
      );

      rows.appendChild(row);
    }

    setStatus(
      $("assetStatus"),
      `${assets.length} project asset(s) synchronized`
    );
  } catch (error) {
    setStatus(
      $("assetStatus"),
      error.message,
      true
    );
  }
}

$("projectForm")
  .addEventListener(
    "submit",
    async event => {
      event.preventDefault();

      const button =
        $("createProjectBtn");

      const name =
        $("projectNameInput")
          .value
          .trim();

      const environment =
        $("environmentInput")
          .value;

      if (!name) {
        return;
      }

      button.disabled = true;

      setStatus(
        $("projectStatus"),
        "Deploying project..."
      );

      try {
        const result =
          await requestJson(
            "/api/apps",
            {
              method: "POST",

              body:
                JSON.stringify({
                  app_name:
                    name,

                  environment
                })
            }
          );

        const created =
          Array.isArray(result)
            ? result[0]
            : null;

        $("projectNameInput")
          .value = "";

        await loadProjects();

        if (created) {
          selectedProject =
            created;

          renderProjects();

          await openProject(
            created
          );
        }

        setStatus(
          $("projectStatus"),
          "Project successfully deployed."
        );
      } catch (error) {
        setStatus(
          $("projectStatus"),
          error.message,
          true
        );
      } finally {
        button.disabled =
          false;
      }
    }
  );

$("assetForm")
  .addEventListener(
    "submit",
    async event => {
      event.preventDefault();

      if (!selectedProject) {
        return;
      }

      const button =
        $("createAssetBtn");

      const input =
        $("assetNameInput");

      const name =
        input.value.trim();

      if (!name) {
        return;
      }

      button.disabled = true;

      setStatus(
        $("assetStatus"),
        "Provisioning project asset..."
      );

      try {
        await requestJson(
          "/api/assets",
          {
            method: "POST",

            body:
              JSON.stringify({
                asset_name:
                  name,

                app_id:
                  selectedProject.id
              })
          }
        );

        input.value = "";

        await loadAssets();

        setStatus(
          $("assetStatus"),
          "Project asset successfully provisioned."
        );
      } catch (error) {
        setStatus(
          $("assetStatus"),
          error.message,
          true
        );
      } finally {
        button.disabled =
          false;
      }
    }
  );

$("refreshAssetsBtn")
  .addEventListener(
    "click",
    loadAssets
  );

$("refreshAllBtn")
  .addEventListener(
    "click",
    async () => {
      await loadHealth();
      await loadProjects();
    }
  );

async function initialize() {
  await loadHealth();
  await loadProjects();

  if (
    projects.length > 0
  ) {
    selectedProject =
      projects[0];

    renderProjects();

    await openProject(
      selectedProject
    );
  }
}

initialize();
</script>

</body>
</html>