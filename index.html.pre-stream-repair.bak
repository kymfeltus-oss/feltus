<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FELTUS LABS | Master Command Console</title>

<style>
:root {
  color-scheme: dark;
  font-family: "Segoe UI", system-ui, sans-serif;
  background: #0d1016;
  color: #edf1f6;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(150,170,200,.08), transparent 35%),
    #0d1016;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 22px 5%;
  border-bottom: 1px solid #2b3340;
  background: rgba(13,16,22,.96);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand h1 {
  margin: 0;
  font-size: 23px;
  letter-spacing: .09em;
}

.brand small {
  display: block;
  margin-top: 5px;
  color: #818c9c;
  letter-spacing: .08em;
}

.mode {
  padding: 8px 12px;
  border: 1px solid #354152;
  border-radius: 999px;
  font-size: 12px;
  color: #a9d7bc;
  background: #171c24;
}

main {
  width: min(1240px, calc(100% - 36px));
  margin: 34px auto 60px;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-end;
  margin-bottom: 28px;
}

.hero h2 {
  margin: 0 0 8px;
  font-size: 30px;
}

.hero p,
.panel p {
  margin: 0;
  color: #929cac;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.metric,
.panel,
.project-card,
.model-card {
  background: #181d26;
  border: 1px solid #2d3542;
  border-radius: 14px;
}

.metric {
  padding: 18px;
}

.metric-label {
  color: #808b9a;
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: .08em;
}

.metric-value {
  margin-top: 8px;
  font-size: 22px;
  font-weight: 650;
}

.panel {
  padding: 24px;
  margin-bottom: 22px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  margin-bottom: 18px;
}

.panel h3 {
  margin: 0 0 6px;
  font-size: 18px;
}

input,
select {
  padding: 12px 13px;
  border-radius: 8px;
  border: 1px solid #445063;
  background: #0f141c;
  color: #fff;
  font: inherit;
}

input {
  flex: 1;
  min-width: 0;
}

select {
  min-width: 160px;
}

button {
  padding: 12px 17px;
  border: 0;
  border-radius: 8px;
  background: #dbe3ec;
  color: #151a22;
  font-weight: 650;
  cursor: pointer;
}

button.secondary {
  background: #303845;
  color: #edf1f6;
}

button.danger {
  background: #453337;
  color: #f4dddd;
}

button:disabled {
  opacity: .5;
  cursor: wait;
}

.inline,
.model-toolbar {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.project-grid,
.model-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 14px;
}

.project-card {
  padding: 18px;
  cursor: pointer;
  transition: .15s ease;
}

.project-card:hover {
  transform: translateY(-2px);
  border-color: #58677b;
}

.project-card.active {
  border-color: #a8b8cc;
  box-shadow: 0 0 0 1px #a8b8cc inset;
}

.project-name,
.model-name {
  font-size: 17px;
  font-weight: 650;
  margin-bottom: 8px;
}

.project-meta,
.model-table {
  font-size: 12px;
  color: #8d98a7;
  line-height: 1.6;
}

.model-table {
  font-family: Consolas, monospace;
  overflow-wrap: anywhere;
}

.badge {
  display: inline-block;
  margin-top: 10px;
  padding: 5px 8px;
  border-radius: 999px;
  background: #252d38;
  font-size: 11px;
  color: #b9c5d3;
}

.rls-on {
  color: #9fd9bd;
}

.rls-off {
  color: #ff9e9e;
}

.status {
  min-height: 24px;
  margin-top: 12px;
  font-size: 13px;
  color: #96a1b0;
}

.success {
  color: #9fd9bd;
}

.error {
  color: #ff9696;
}

.context-box {
  padding: 16px;
  background: #11161e;
  border: 1px solid #2c3440;
  border-radius: 10px;
  margin-bottom: 16px;
}

.context-name {
  font-weight: 650;
}

.context-id {
  margin-top: 5px;
  font: 12px Consolas, monospace;
  color: #8592a3;
}

.column-builder {
  display: grid;
  gap: 10px;
  margin-top: 18px;
}

.column-row {
  display: grid;
  grid-template-columns: minmax(170px, 1fr) 180px 120px auto;
  gap: 10px;
  align-items: center;
  padding: 12px;
  border: 1px solid #303946;
  border-radius: 10px;
  background: #11161e;
}

.column-row input,
.column-row select {
  width: 100%;
}

.nullable-control,
.rls-control {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #a3adba;
  font-size: 13px;
}

.nullable-control input,
.rls-control input {
  width: auto;
  flex: none;
}

.model-card {
  padding: 18px;
}

.model-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16px;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  text-align: left;
  padding: 13px;
  border-bottom: 1px solid #2c3440;
  vertical-align: top;
}

th {
  color: #8b96a6;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

pre {
  margin: 0;
  white-space: pre-wrap;
  font-size: 12px;
  font-family: Consolas, monospace;
  color: #b9c3d0;
}

.empty {
  padding: 28px;
  text-align: center;
  color: #737f90;
}

.hidden {
  display: none !important;
}

footer {
  text-align: center;
  color: #667284;
  font-size: 12px;
  padding: 8px 0;
}

@media (max-width: 850px) {
  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero,
  .panel-header {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (max-width: 700px) {
  .column-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .metrics {
    grid-template-columns: 1fr;
  }

  .inline,
  .model-toolbar {
    flex-direction: column;
  }

  input,
  select,
  button {
    width: 100%;
  }
}
﻿.ai-status-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 18px;
}

.ai-status-card,
.ai-chat,
.ai-side-card {
  border: 1px solid #303946;
  background: #11161e;
  border-radius: 12px;
}

.ai-status-card {
  padding: 16px;
}

.ai-status-label {
  color: #7f8b9b;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .07em;
}

.ai-status-value {
  margin-top: 7px;
  font-size: 18px;
  font-weight: 650;
}

.ai-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 290px;
  gap: 16px;
}

.ai-chat {
  overflow: hidden;
}

.ai-chat-header {
  padding: 16px 18px;
  border-bottom: 1px solid #29313c;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.ai-conversation {
  min-height: 320px;
  max-height: 520px;
  overflow-y: auto;
  padding: 18px;
}

.ai-empty {
  padding: 75px 24px;
  text-align: center;
  color: #737f90;
}

.ai-message {
  padding: 14px 16px;
  border-radius: 11px;
  margin-bottom: 16px;
  white-space: pre-wrap;
  line-height: 1.55;
}

.ai-message-user {
  background: #1b2a3d;
  margin-left: 12%;
}

.ai-message-assistant {
  background: #171e28;
  border: 1px solid #2c3745;
  margin-right: 5%;
}

.ai-message-label {
  display: block;
  margin-bottom: 7px;
  color: #8f9baa;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.ai-composer {
  padding: 14px;
  border-top: 1px solid #29313c;
}

.ai-composer textarea {
  width: 100%;
  min-height: 95px;
  resize: vertical;
  padding: 13px;
  border-radius: 9px;
  border: 1px solid #445063;
  background: #0e131a;
  color: #fff;
  font: inherit;
}

.ai-composer-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 10px;
}

.ai-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.ai-suggestion {
  padding: 8px 11px;
  font-size: 12px;
}

.ai-side {
  display: grid;
  gap: 14px;
  align-content: start;
}

.ai-side-card {
  padding: 16px;
}

.ai-side-card h4 {
  margin: 0 0 12px;
}

.ai-detail {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid #252d37;
  color: #8f9baa;
  font-size: 12px;
}

.ai-detail:last-child {
  border-bottom: 0;
}

.ai-detail strong {
  color: #edf1f6;
  text-align: right;
}

.ai-private {
  color: #9fd9bd !important;
}

#aiModelSelect {
  width: 100%;
  margin-bottom: 12px;
}

@media (max-width: 900px) {
  .ai-status-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .ai-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .ai-status-grid {
    grid-template-columns: 1fr;
  }
}

</style>
</head>

<body>

<header>
  <div class="brand">
    <h1>FELTUS LABS</h1>
    <small>MASTER COMMAND CONSOLE</small>
  </div>

  <div class="mode">
    PRIVATE LOCAL DEVELOPMENT
  </div>
</header>

<main>

<section class="hero">
  <div>
    <h2>Platform Command Center</h2>
    <p>Projects, infrastructure, relational models and local platform state.</p>
  </div>

  <button id="refreshAllBtn" class="secondary" type="button">
    Refresh Platform
  </button>
</section>


<section class="metrics">

  <div class="metric">
    <div class="metric-label">FELTUS Engine</div>
    <div id="engineMetric" class="metric-value">Checking</div>
  </div>

  <div class="metric">
    <div class="metric-label">Projects</div>
    <div id="projectMetric" class="metric-value">—</div>
  </div>

  <div class="metric">
    <div class="metric-label">Selected Assets</div>
    <div id="assetMetric" class="metric-value">—</div>
  </div>

  <div class="metric">
    <div class="metric-label">Data Models</div>
    <div id="modelMetric" class="metric-value">—</div>
  </div>

</section>


<section class="panel">

  <div class="panel-header">
    <div>
      <h3>Deploy New Project</h3>
      <p>Create a real FELTUS application workspace.</p>
    </div>
  </div>

  <form id="projectForm" class="inline">

    <input
      id="projectNameInput"
      type="text"
      maxlength="200"
      required
      placeholder="Project name"
    >

    <select id="environmentInput">
      <option value="development">Development</option>
      <option value="staging">Staging</option>
      <option value="production">Production</option>
    </select>

    <button id="createProjectBtn" type="submit">
      Create Project
    </button>

  </form>

  <div id="projectStatus" class="status"></div>

</section>


<section class="panel">

  <div class="panel-header">
    <div>
      <h3>Application Registry</h3>
      <p>Select a project to manage its infrastructure and relational models.</p>
    </div>
  </div>

  <div id="projectGrid" class="project-grid"></div>

</section>


<section id="workspacePanel" class="panel hidden">

  <div class="panel-header">
    <div>
      <h3>Project Workspace</h3>
      <p>Provision project-scoped infrastructure assets.</p>
    </div>
  </div>

  <div class="context-box">
    <div id="selectedProjectName" class="context-name"></div>
    <div id="selectedProjectId" class="context-id"></div>
    <div id="selectedProjectEnvironment" class="badge"></div>
  </div>

  <form id="assetForm" class="inline">

    <input
      id="assetNameInput"
      type="text"
      maxlength="200"
      required
      placeholder="New project asset"
    >

    <button id="createAssetBtn" type="submit">
      Create Asset
    </button>

  </form>

  <div id="assetStatus" class="status"></div>

</section>


<section id="assetPanel" class="panel hidden">

  <div class="panel-header">

    <div>
      <h3>Project Infrastructure</h3>
      <p>Live database-backed assets for the selected project.</p>
    </div>

    <button id="refreshAssetsBtn" class="secondary" type="button">
      Refresh Assets
    </button>

  </div>

  <div class="table-wrap">

    <table>

      <thead>
        <tr>
          <th>Tracking ID</th>
          <th>Resource</th>
          <th>Payload</th>
          <th>Created</th>
        </tr>
      </thead>

      <tbody id="assetRows"></tbody>

    </table>

  </div>

</section>


<section id="modelerPanel" class="panel hidden">

  <div class="panel-header">

    <div>
      <h3>Relational Workspace Modeler</h3>
      <p>Create controlled PostgreSQL tables inside the selected FELTUS project.</p>
    </div>

  </div>

  <form id="modelForm">

    <div class="model-toolbar">

      <input
        id="modelNameInput"
        type="text"
        maxlength="40"
        required
        placeholder="Table name — e.g. invoices"
      >

      <label class="rls-control">
        <input id="modelRlsInput" type="checkbox" checked>
        Enable RLS
      </label>

      <button id="addColumnBtn" class="secondary" type="button">
        + Add Column
      </button>

      <button id="createModelBtn" type="submit">
        Create Table
      </button>

    </div>

    <div id="columnBuilder" class="column-builder"></div>

  </form>

  <div id="modelStatus" class="status"></div>

</section>


<section id="modelsPanel" class="panel hidden">

  <div class="panel-header">

    <div>
      <h3>Project Data Models</h3>
      <p>Physical PostgreSQL tables managed by FELTUS.</p>
    </div>

    <button id="refreshModelsBtn" class="secondary" type="button">
      Refresh Models
    </button>

  </div>

  <div id="modelGrid" class="model-grid"></div>

</section>


﻿<section id="aiHubPanel" class="panel hidden">

  <div class="panel-header">
    <div>
      <h3>Private AI Hub</h3>
      <p>
        Local AI grounded in the selected FELTUS project's real infrastructure.
      </p>
    </div>

    <button id="refreshAIButton" class="secondary" type="button">
      Refresh AI
    </button>
  </div>


  <div class="ai-status-grid">

    <div class="ai-status-card">
      <div class="ai-status-label">AI Engine</div>
      <div id="aiEngineStatus" class="ai-status-value">Checking</div>
    </div>

    <div class="ai-status-card">
      <div class="ai-status-label">Active Project</div>
      <div id="aiProjectName" class="ai-status-value">—</div>
    </div>

    <div class="ai-status-card">
      <div class="ai-status-label">Project Assets</div>
      <div id="aiAssetCount" class="ai-status-value">—</div>
    </div>

    <div class="ai-status-card">
      <div class="ai-status-label">Relational Models</div>
      <div id="aiModelCount" class="ai-status-value">—</div>
    </div>

  </div>


  <div class="ai-layout">

    <div class="ai-chat">

      <div class="ai-chat-header">
        <div>
          <strong>FELTUS AI Assistant</strong>
          <div class="project-meta">
            Private project-aware local inference
          </div>
        </div>

        <button id="clearAIChatButton" class="secondary" type="button">
          Clear Chat
        </button>
      </div>


      <div id="aiConversation" class="ai-conversation">
        <div id="aiEmptyState" class="ai-empty">
          Ask FELTUS AI about this project's schema, assets,
          models, security, or architecture.
        </div>
      </div>


      <div class="ai-composer">

        <textarea
          id="aiPromptInput"
          maxlength="8000"
          placeholder="Ask a question about this FELTUS project..."
        ></textarea>

        <div class="ai-suggestions">

          <button
            class="secondary ai-suggestion"
            type="button"
            data-ai-prompt="Explain the relational schema configured for this project."
          >
            Explain Schema
          </button>

          <button
            class="secondary ai-suggestion"
            type="button"
            data-ai-prompt="Which relational tables have RLS enabled or disabled?"
          >
            Check RLS
          </button>

          <button
            class="secondary ai-suggestion"
            type="button"
            data-ai-prompt="Review this project's backend architecture and suggest the next useful data model."
          >
            Suggest Next Model
          </button>

        </div>


        <div class="ai-composer-actions">

          <div id="aiChatStatus" class="status"></div>

          <button id="sendAIButton" type="button">
            Send to Local AI
          </button>

        </div>

      </div>

    </div>


    <aside class="ai-side">

      <div class="ai-side-card">

        <h4>Model & Runtime</h4>

        <select id="aiModelSelect"></select>

        <div class="ai-detail">
          <span>Runtime</span>
          <strong>Ollama</strong>
        </div>

        <div class="ai-detail">
          <span>Execution</span>
          <strong>Local</strong>
        </div>

        <div class="ai-detail">
          <span>Cloud Provider</span>
          <strong class="ai-private">None</strong>
        </div>

      </div>


      <div class="ai-side-card">

        <h4>Project Context</h4>

        <div class="ai-detail">
          <span>Project</span>
          <strong id="aiContextProject">—</strong>
        </div>

        <div class="ai-detail">
          <span>Assets</span>
          <strong id="aiContextAssets">—</strong>
        </div>

        <div class="ai-detail">
          <span>Models</span>
          <strong id="aiContextModels">—</strong>
        </div>

      </div>


      <div class="ai-side-card">

        <h4>Privacy & Security</h4>

        <p class="project-meta">
          FELTUS sends inference only to the locally running
          Ollama service and supplies context through its
          authenticated backend.
        </p>

        <div class="badge ai-private">
          PRIVATE LOCAL AI
        </div>

      </div>

    </aside>

  </div>

</section>


<footer>
  FELTUS LABS · Private Development Platform
</footer>

</main>


<script>
"use strict";

const $ = id =>
  document.getElementById(id);

let projects = [];
let selectedProject = null;
let models = [];
let aiRuntime = null;


function setStatus(
  element,
  message,
  error = false
) {
  element.textContent = message;

  element.className =
    "status " +
    (error ? "error" : "success");
}


async function requestJson(
  url,
  options = {}
) {
  const response =
    await fetch(
      url,
      {
        ...options,

        headers: {
          Accept: "application/json",

          ...(options.body
            ? {
                "Content-Type":
                  "application/json"
              }
            : {}),

          ...(options.headers || {})
        }
      }
    );

  const text =
    await response.text();

  let data;

  try {
    data =
      JSON.parse(text);
  } catch {
    data = {};
  }

  if (!response.ok) {
    throw new Error(
      data.error ||
      data.message ||
      `HTTP ${response.status}`
    );
  }

  return data;
}


async function loadHealth() {
  try {
    const health =
      await requestJson(
        "/api/health"
      );

    $("engineMetric").textContent =
      health.status === "online"
        ? "Online"
        : "Offline";

  } catch {
    $("engineMetric").textContent =
      "Offline";
  }
}


function projectCard(project) {
  const card =
    document.createElement("div");

  card.className =
    "project-card" +
    (
      selectedProject?.id ===
      project.id
        ? " active"
        : ""
    );


  const name =
    document.createElement("div");

  name.className =
    "project-name";

  name.textContent =
    project.app_name;


  const meta =
    document.createElement("div");

  meta.className =
    "project-meta";

  meta.textContent =
    `Created ${new Date(
      project.created_at
    ).toLocaleString()}`;


  const badge =
    document.createElement("div");

  badge.className =
    "badge";

  badge.textContent =
    project.environment;


  card.append(
    name,
    meta,
    badge
  );


  card.addEventListener(
    "click",
    async () => {
      selectedProject =
        project;

      renderProjects();

      await openProject(
        project
      );
    }
  );


  return card;
}


function renderProjects() {
  const grid =
    $("projectGrid");

  grid.replaceChildren();

  $("projectMetric").textContent =
    String(projects.length);


  if (!projects.length) {
    const empty =
      document.createElement("div");

    empty.className =
      "empty";

    empty.textContent =
      "No FELTUS projects have been deployed.";

    grid.appendChild(empty);

    return;
  }


  for (const project of projects) {
    grid.appendChild(
      projectCard(project)
    );
  }
}


async function loadProjects() {
  setStatus(
    $("projectStatus"),
    "Synchronizing project registry..."
  );

  try {
    projects =
      await requestJson(
        "/api/apps"
      );


    if (
      !Array.isArray(projects)
    ) {
      throw new Error(
        "Invalid project response."
      );
    }


    renderProjects();


    setStatus(
      $("projectStatus"),
      `${projects.length} project(s) synchronized`
    );

  } catch (error) {
    setStatus(
      $("projectStatus"),
      error.message,
      true
    );
  }
}


async function openProject(project) {
  $("workspacePanel")
    .classList
    .remove("hidden");

  $("assetPanel")
    .classList
    .remove("hidden");

  $("modelerPanel")
    .classList
    .remove("hidden");

  $("modelsPanel")
    .classList
    .remove("hidden");


  $("selectedProjectName")
    .textContent =
    project.app_name;

  $("selectedProjectId")
    .textContent =
    project.id;

  $("selectedProjectEnvironment")
    .textContent =
    project.environment;


  await Promise.all([
    loadAssets(),
    loadModels()
  ]);
}


async function loadAssets() {
  if (!selectedProject) {
    return;
  }


  setStatus(
    $("assetStatus"),
    "Loading project assets..."
  );


  try {
    const assets =
      await requestJson(
        `/api/assets?app_id=${encodeURIComponent(
          selectedProject.id
        )}`
      );


    if (
      !Array.isArray(assets)
    ) {
      throw new Error(
        "Invalid asset response."
      );
    }


    $("assetMetric").textContent =
      String(assets.length);


    const rows =
      $("assetRows");

    rows.replaceChildren();


    if (!assets.length) {
      const row =
        document.createElement("tr");

      const cell =
        document.createElement("td");

      cell.colSpan = 4;
      cell.className =
        "empty";

      cell.textContent =
        "No assets exist for this project.";

      row.appendChild(cell);
      rows.appendChild(row);
    }


    for (const asset of assets) {
      const row =
        document.createElement("tr");


      const idCell =
        document.createElement("td");

      idCell.textContent =
        asset.id || "";


      const nameCell =
        document.createElement("td");

      nameCell.textContent =
        asset.asset_name || "";


      const payloadCell =
        document.createElement("td");

      const pre =
        document.createElement("pre");

      pre.textContent =
        JSON.stringify(
          asset.payload || {},
          null,
          2
        );

      payloadCell.appendChild(
        pre
      );


      const createdCell =
        document.createElement("td");

      createdCell.textContent =
        asset.created_at
          ? new Date(
              asset.created_at
            ).toLocaleString()
          : "";


      row.append(
        idCell,
        nameCell,
        payloadCell,
        createdCell
      );

      rows.appendChild(row);
    }


    setStatus(
      $("assetStatus"),
      `${assets.length} project asset(s) synchronized`
    );

  } catch (error) {
    setStatus(
      $("assetStatus"),
      error.message,
      true
    );
  }
}


function createColumnRow({
  name = "",
  type = "text",
  nullable = true
} = {}) {
  const row =
    document.createElement("div");

  row.className =
    "column-row";


  const nameInput =
    document.createElement("input");

  nameInput.type =
    "text";

  nameInput.maxLength =
    40;

  nameInput.placeholder =
    "column_name";

  nameInput.value =
    name;

  nameInput.dataset.role =
    "column-name";


  const typeSelect =
    document.createElement("select");

  typeSelect.dataset.role =
    "column-type";


  const types = [
    "text",
    "integer",
    "bigint",
    "numeric",
    "boolean",
    "date",
    "timestamptz",
    "uuid",
    "jsonb"
  ];


  for (const value of types) {
    const option =
      document.createElement("option");

    option.value =
      value;

    option.textContent =
      value;

    option.selected =
      value === type;

    typeSelect.appendChild(
      option
    );
  }


  const nullableLabel =
    document.createElement("label");

  nullableLabel.className =
    "nullable-control";


  const nullableInput =
    document.createElement("input");

  nullableInput.type =
    "checkbox";

  nullableInput.checked =
    nullable;

  nullableInput.dataset.role =
    "column-nullable";


  nullableLabel.append(
    nullableInput,
    document.createTextNode(
      "Nullable"
    )
  );


  const removeButton =
    document.createElement("button");

  removeButton.type =
    "button";

  removeButton.className =
    "secondary";

  removeButton.textContent =
    "Remove";


  removeButton.addEventListener(
    "click",
    () => {
      row.remove();
    }
  );


  row.append(
    nameInput,
    typeSelect,
    nullableLabel,
    removeButton
  );


  $("columnBuilder")
    .appendChild(row);
}


function readColumns() {
  const rows = [
    ...$("columnBuilder")
      .querySelectorAll(
        ".column-row"
      )
  ];


  const columns = [];


  for (const row of rows) {
    const name =
      row
        .querySelector(
          '[data-role="column-name"]'
        )
        .value
        .trim();


    const type =
      row
        .querySelector(
          '[data-role="column-type"]'
        )
        .value;


    const nullable =
      row
        .querySelector(
          '[data-role="column-nullable"]'
        )
        .checked;


    if (!name) {
      throw new Error(
        "Every column requires a name."
      );
    }


    if (
      !/^[a-z][a-z0-9_]{0,39}$/.test(
        name
      )
    ) {
      throw new Error(
        "Column names must use lowercase letters, numbers and underscores."
      );
    }


    columns.push({
      name,
      type,
      nullable
    });
  }


  const names =
    columns.map(
      item =>
        item.name
    );


  if (
    new Set(names).size !==
    names.length
  ) {
    throw new Error(
      "Duplicate column names are not allowed."
    );
  }


  return columns;
}


function renderModels() {
  const grid =
    $("modelGrid");

  grid.replaceChildren();

  $("modelMetric").textContent =
    String(models.length);


  if (!models.length) {
    const empty =
      document.createElement("div");

    empty.className =
      "empty";

    empty.textContent =
      "No relational models exist for this project.";

    grid.appendChild(empty);

    return;
  }


  for (const model of models) {
    const card =
      document.createElement("div");

    card.className =
      "model-card";


    const name =
      document.createElement("div");

    name.className =
      "model-name";

    name.textContent =
      model.logical_name;


    const physical =
      document.createElement("div");

    physical.className =
      "model-table";

    physical.textContent =
      model.physical_table_name;


    const actions =
      document.createElement("div");

    actions.className =
      "model-actions";


    const status =
      document.createElement("span");

    status.className =
      model.rls_enabled
        ? "rls-on"
        : "rls-off";

    status.textContent =
      model.rls_enabled
        ? "RLS ENABLED"
        : "RLS DISABLED";


    const toggle =
      document.createElement("button");

    toggle.type =
      "button";

    toggle.className =
      model.rls_enabled
        ? "danger"
        : "secondary";

    toggle.textContent =
      model.rls_enabled
        ? "Disable RLS"
        : "Enable RLS";


    toggle.addEventListener(
      "click",
      async () => {
        toggle.disabled =
          true;

        try {
          await requestJson(
            "/api/models/rls",
            {
              method:
                "POST",

              body:
                JSON.stringify({
                  model_id:
                    model.id,

                  enabled:
                    !model.rls_enabled
                })
            }
          );


          await loadModels();

        } catch (error) {
          setStatus(
            $("modelStatus"),
            error.message,
            true
          );

        } finally {
          toggle.disabled =
            false;
        }
      }
    );


    actions.append(
      status,
      toggle
    );


    card.append(
      name,
      physical,
      actions
    );


    grid.appendChild(
      card
    );
  }
}


async function loadModels() {
  if (!selectedProject) {
    return;
  }


  setStatus(
    $("modelStatus"),
    "Loading relational models..."
  );


  try {
    models =
      await requestJson(
        `/api/models?app_id=${encodeURIComponent(
          selectedProject.id
        )}`
      );


    if (
      !Array.isArray(models)
    ) {
      throw new Error(
        "Invalid model response."
      );
    }


    renderModels();


    setStatus(
      $("modelStatus"),
      `${models.length} relational model(s) synchronized`
    );

  } catch (error) {
    setStatus(
      $("modelStatus"),
      error.message,
      true
    );
  }
}


$("projectForm")
  .addEventListener(
    "submit",
    async event => {
      event.preventDefault();

      const button =
        $("createProjectBtn");

      const name =
        $("projectNameInput")
          .value
          .trim();

      const environment =
        $("environmentInput")
          .value;


      if (!name) {
        return;
      }


      button.disabled =
        true;


      try {
        const result =
          await requestJson(
            "/api/apps",
            {
              method:
                "POST",

              body:
                JSON.stringify({
                  app_name:
                    name,

                  environment
                })
            }
          );


        const created =
          Array.isArray(result)
            ? result[0]
            : null;


        $("projectNameInput")
          .value = "";


        await loadProjects();


        if (created) {
          selectedProject =
            created;

          renderProjects();

          await openProject(
            created
          );
        }


        setStatus(
          $("projectStatus"),
          "Project successfully deployed."
        );

      } catch (error) {
        setStatus(
          $("projectStatus"),
          error.message,
          true
        );

      } finally {
        button.disabled =
          false;
      }
    }
  );


$("assetForm")
  .addEventListener(
    "submit",
    async event => {
      event.preventDefault();


      if (!selectedProject) {
        return;
      }


      const input =
        $("assetNameInput");

      const name =
        input.value.trim();

      const button =
        $("createAssetBtn");


      if (!name) {
        return;
      }


      button.disabled =
        true;


      try {
        await requestJson(
          "/api/assets",
          {
            method:
              "POST",

            body:
              JSON.stringify({
                asset_name:
                  name,

                app_id:
                  selectedProject.id
              })
          }
        );


        input.value = "";

        await loadAssets();


        setStatus(
          $("assetStatus"),
          "Project asset successfully provisioned."
        );

      } catch (error) {
        setStatus(
          $("assetStatus"),
          error.message,
          true
        );

      } finally {
        button.disabled =
          false;
      }
    }
  );


$("addColumnBtn")
  .addEventListener(
    "click",
    () => {
      createColumnRow();
    }
  );


$("modelForm")
  .addEventListener(
    "submit",
    async event => {
      event.preventDefault();


      if (!selectedProject) {
        return;
      }


      const tableName =
        $("modelNameInput")
          .value
          .trim();


      if (
        !/^[a-z][a-z0-9_]{0,39}$/.test(
          tableName
        )
      ) {
        setStatus(
          $("modelStatus"),
          "Invalid table name. Use lowercase letters, numbers and underscores.",
          true
        );

        return;
      }


      let columns;


      try {
        columns =
          readColumns();

      } catch (error) {
        setStatus(
          $("modelStatus"),
          error.message,
          true
        );

        return;
      }


      const button =
        $("createModelBtn");

      button.disabled =
        true;


      setStatus(
        $("modelStatus"),
        "Creating PostgreSQL table..."
      );


      try {
        const result =
          await requestJson(
            "/api/models",
            {
              method:
                "POST",

              body:
                JSON.stringify({
                  app_id:
                    selectedProject.id,

                  table_name:
                    tableName,

                  columns,

                  enable_rls:
                    $("modelRlsInput")
                      .checked
                })
            }
          );


        $("modelNameInput")
          .value = "";


        $("columnBuilder")
          .replaceChildren();


        createColumnRow({
          name:
            "name",

          type:
            "text",

          nullable:
            false
        });


        await loadModels();


        setStatus(
          $("modelStatus"),
          `Table created: ${result.physical_table_name}`
        );

      } catch (error) {
        setStatus(
          $("modelStatus"),
          error.message,
          true
        );

      } finally {
        button.disabled =
          false;
      }
    }
  );


$("refreshAssetsBtn")
  .addEventListener(
    "click",
    loadAssets
  );


$("refreshModelsBtn")
  .addEventListener(
    "click",
    loadModels
  );


$("refreshAllBtn")
  .addEventListener(
    "click",
    async () => {
      await loadHealth();
      await loadProjects();

      if (
        selectedProject
      ) {
        await Promise.all([
          loadAssets(),
          loadModels()
        ]);
      }
    }
  );


async function initialize() {
  createColumnRow({
    name:
      "name",

    type:
      "text",

    nullable:
      false
  });


  await loadHealth();
  await loadProjects();


  if (
    projects.length > 0
  ) {
    selectedProject =
      projects[0];

    renderProjects();

    await openProject(
      selectedProject
    );
  }
}



﻿function clearAIConversation() {
  const conversation =
    $("aiConversation");

  conversation.replaceChildren();

  const empty =
    document.createElement("div");

  empty.id =
    "aiEmptyState";

  empty.className =
    "ai-empty";

  empty.textContent =
    "Ask FELTUS AI about this project's schema, assets, models, security, or architecture.";

  conversation.appendChild(
    empty
  );
}


function appendAIMessage(
  role,
  text
) {
  const conversation =
    $("aiConversation");

  const empty =
    $("aiEmptyState");

  if (empty) {
    empty.remove();
  }


  const message =
    document.createElement("div");

  message.className =
    role === "user"
      ? "ai-message ai-message-user"
      : "ai-message ai-message-assistant";


  const label =
    document.createElement("span");

  label.className =
    "ai-message-label";

  label.textContent =
    role === "user"
      ? "You"
      : "FELTUS AI · Local";


  const content =
    document.createElement("div");

  content.textContent =
    text;


  message.append(
    label,
    content
  );

  conversation.appendChild(
    message
  );

  conversation.scrollTop =
    conversation.scrollHeight;
}


async function loadAIHubStatus() {
  if (!selectedProject) {
    return;
  }


  $("aiHubPanel")
    .classList
    .remove("hidden");


  $("aiProjectName")
    .textContent =
    selectedProject.app_name;

  $("aiContextProject")
    .textContent =
    selectedProject.app_name;


  $("aiAssetCount")
    .textContent =
    $("assetMetric").textContent;

  $("aiModelCount")
    .textContent =
    String(models.length);

  $("aiContextAssets")
    .textContent =
    $("assetMetric").textContent;

  $("aiContextModels")
    .textContent =
    String(models.length);


  try {
    aiRuntime =
      await requestJson(
        "/api/ai/status"
      );


    $("aiEngineStatus")
      .textContent =
      aiRuntime.status === "online"
        ? "Online"
        : "Offline";


    const select =
      $("aiModelSelect");

    const previousModel =
      select.value;

    select.replaceChildren();


    const installed =
      Array.isArray(
        aiRuntime.models
      )
        ? aiRuntime.models
        : [];


    for (const model of installed) {
      const option =
        document.createElement("option");

      option.value =
        model.name;

      option.textContent =
        model.name;

      select.appendChild(
        option
      );
    }


    if (
      previousModel &&
      installed.some(
        model =>
          model.name === previousModel
      )
    ) {
      select.value =
        previousModel;

    } else if (
      aiRuntime.default_model &&
      installed.some(
        model =>
          model.name ===
          aiRuntime.default_model
      )
    ) {
      select.value =
        aiRuntime.default_model;
    }


    setStatus(
      $("aiChatStatus"),
      installed.length +
      " local model(s) available"
    );

  } catch (error) {
    $("aiEngineStatus")
      .textContent =
      "Offline";

    setStatus(
      $("aiChatStatus"),
      error.message,
      true
    );
  }
}


﻿async function sendAIMessage() {
  if (!selectedProject) {
    setStatus(
      $("aiChatStatus"),
      "Select a project first.",
      true
    );

    return;
  }


  const prompt =
    $("aiPromptInput")
      .value
      .trim();


  if (!prompt) {
    return;
  }


  const model =
    $("aiModelSelect")
      .value;


  if (!model) {
    setStatus(
      $("aiChatStatus"),
      "No local AI model is selected.",
      true
    );

    return;
  }


  const button =
    $("sendAIButton");

  button.disabled =
    true;


  appendAIMessage(
    "user",
    prompt
  );


  $("aiPromptInput")
    .value = "";


  setStatus(
    $("aiChatStatus"),
    "Connecting to local AI..."
  );


  let assistantContent =
    null;


  try {
    const response =
      await fetch(
        "/api/ai/chat/stream",
        {
          method:
            "POST",

          headers: {
            "Content-Type":
              "application/json",

            Accept:
              "application/x-ndjson"
          },

          body:
            JSON.stringify({
              app_id:
                selectedProject.id,

              model,

              prompt
            })
        }
      );


    if (!response.ok) {
      const errorText =
        await response.text();

      throw new Error(
        errorText ||
        "Streaming AI request failed."
      );
    }


    if (!response.body) {
      throw new Error(
        "Streaming response body unavailable."
      );
    }


    const conversation =
      $("aiConversation");


    const empty =
      $("aiEmptyState");

    if (empty) {
      empty.remove();
    }


    const message =
      document.createElement(
        "div"
      );

    message.className =
      "ai-message ai-message-assistant";


    const label =
      document.createElement(
        "span"
      );

    label.className =
      "ai-message-label";

    label.textContent =
      "FELTUS AI · Local";


    assistantContent =
      document.createElement(
        "div"
      );


    message.append(
      label,
      assistantContent
    );


    conversation.appendChild(
      message
    );


    const reader =
      response.body.getReader();

    const decoder =
      new TextDecoder();

    let buffer = "";


    const processLine =
      line => {
        if (!line.trim()) {
          return;
        }


        const event =
          JSON.parse(line);


        if (
          event.type === "meta"
        ) {
          if (event.context) {
            const assets =
              String(
                event.context.assets ??
                0
              );

            const modelCount =
              String(
                event.context.models ??
                0
              );


            $("aiAssetCount")
              .textContent =
              assets;

            $("aiContextAssets")
              .textContent =
              assets;

            $("aiModelCount")
              .textContent =
              modelCount;

            $("aiContextModels")
              .textContent =
              modelCount;
          }


          setStatus(
            $("aiChatStatus"),
            "Generating locally..."
          );

          return;
        }


        if (
          event.type === "token"
        ) {
          assistantContent.textContent +=
            event.text || "";


          conversation.scrollTop =
            conversation.scrollHeight;

          return;
        }


        if (
          event.type === "done"
        ) {
          setStatus(
            $("aiChatStatus"),
            "Local inference complete."
          );

          return;
        }


        if (
          event.type === "error"
        ) {
          throw new Error(
            event.error ||
            "Local AI stream failed."
          );
        }
      };


    while (true) {
      const {
        done,
        value
      } =
        await reader.read();


      if (done) {
        break;
      }


      buffer +=
        decoder.decode(
          value,
          {
            stream: true
          }
        );


      let newlineIndex;


      while (
        (
          newlineIndex =
            buffer.indexOf("\n")
        ) >= 0
      ) {
        const line =
          buffer.slice(
            0,
            newlineIndex
          );


        buffer =
          buffer.slice(
            newlineIndex + 1
          );


        processLine(
          line
        );
      }
    }


    buffer +=
      decoder.decode();


    if (buffer.trim()) {
      processLine(
        buffer
      );
    }


    if (
      !assistantContent.textContent.trim()
    ) {
      assistantContent.textContent =
        "No response returned.";
    }

  } catch (error) {
    if (assistantContent) {
      assistantContent.textContent +=
        "\n\nAI request failed: " +
        error.message;

    } else {
      appendAIMessage(
        "assistant",
        "AI request failed: " +
        error.message
      );
    }


    setStatus(
      $("aiChatStatus"),
      error.message,
      true
    );

  } finally {
    button.disabled =
      false;
  }
}


$("sendAIButton");

  button.disabled =
    true;


  appendAIMessage(
    "user",
    prompt
  );


  $("aiPromptInput")
    .value = "";


  setStatus(
    $("aiChatStatus"),
    "Running local inference..."
  );


  try {
    const result =
      await requestJson(
        "/api/ai/chat",
        {
          method:
            "POST",

          body:
            JSON.stringify({
              app_id:
                selectedProject.id,

              model,

              prompt
            })
        }
      );


    appendAIMessage(
      "assistant",
      result.response ||
      "No response returned."
    );


    if (result.context) {
      const assets =
        String(
          result.context.assets ?? 0
        );

      const modelCount =
        String(
          result.context.models ?? 0
        );

      $("aiAssetCount")
        .textContent =
        assets;

      $("aiContextAssets")
        .textContent =
        assets;

      $("aiModelCount")
        .textContent =
        modelCount;

      $("aiContextModels")
        .textContent =
        modelCount;
    }


    setStatus(
      $("aiChatStatus"),
      "Completed locally with " +
      (result.model || model)
    );

  } catch (error) {
    appendAIMessage(
      "assistant",
      "AI request failed: " +
      error.message
    );

    setStatus(
      $("aiChatStatus"),
      error.message,
      true
    );

  } finally {
    button.disabled =
      false;
  }
}


$("sendAIButton")
  .addEventListener(
    "click",
    sendAIMessage
  );


$("aiPromptInput")
  .addEventListener(
    "keydown",
    event => {
      if (
        event.key === "Enter" &&
        !event.shiftKey
      ) {
        event.preventDefault();

        sendAIMessage();
      }
    }
  );


