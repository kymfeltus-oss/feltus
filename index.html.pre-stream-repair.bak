      );
    }
  );



/* =========================================================
   FELTUS PRIVATE AI PROJECT HOOK
========================================================= */

const __feltusOriginalOpenProject =
  openProject;

openProject =
  async function(project) {
    await __feltusOriginalOpenProject(
      project
    );

    await loadAIHubStatus();
  };


initialize();
</script>


