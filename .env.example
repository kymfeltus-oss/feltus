# Production and Coolify configuration. Compose supplies the internal gateway,
# container bind address, port, publishable key, and persistent storage path.
FELTUS_ENV=production
FELTUS_HOST=0.0.0.0
FELTUS_PORT=8080
FELTUS_PUBLIC_URL=https://feltuslabs.com
FELTUS_GATEWAY_URL=
FELTUS_PUBLISHABLE_KEY=
FELTUS_OWNER_EMAIL=owner@example.com
FELTUS_OWNER_PASSWORD=replace-with-a-strong-owner-password
FELTUS_ALLOWED_ORIGINS=https://feltuslabs.com,https://www.feltuslabs.com
# scripts/dev.js uses the native Windows Ollama default: http://127.0.0.1:11434.
# In Coolify, set an internal Ollama-compatible endpoint and approve its exact
# host in FELTUS_AI_ALLOWED_PRIVATE_HOSTS, or use a trusted HTTPS provider and
# list its exact hostname in FELTUS_AI_TRUSTED_HOSTS.
FELTUS_AI_ENDPOINT=
FELTUS_AI_ENDPOINT_TRUST=external_unverified
FELTUS_AI_SEND_HISTORY=false
FELTUS_AI_SEND_PROJECT_CONTEXT=false
FELTUS_AI_MAX_HISTORY_MESSAGES=20
FELTUS_AI_ALLOWED_PRIVATE_HOSTS=
FELTUS_AI_TRUSTED_HOSTS=
FELTUS_AI_MODEL=llama3:8b
FELTUS_STORAGE_ROOT=/data/feltus-storage
FELTUS_EVIDENCE_EXTRACTION_URL=
FELTUS_EVIDENCE_EXTRACTION_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
FELTUS_EVIDENCE_EXTRACTION_TIMEOUT_MS=180000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=FELTUS

# Generate private values before deploying. Coolify stores them as environment
# secrets; keep local copies outside Git.
FELTUS_BACKUP_DIR=/srv/backups/feltus
POSTGRES_PASSWORD=replace-with-long-alphanumeric-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ANON_KEY=replace-with-anon-jwt-signed-by-JWT_SECRET
SERVICE_ROLE_KEY=replace-with-service-role-jwt-signed-by-JWT_SECRET
SECRET_KEY_BASE=replace-with-at-least-64-random-characters
REALTIME_DB_ENC_KEY=replace-with-16-char-key
